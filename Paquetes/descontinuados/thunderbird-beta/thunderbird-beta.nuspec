<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>thunderbird-beta</id>
    <version>999.0.1-deprecated</version>
    <packageSourceUrl>https://github.com/DEUS-DEI/ChocoLateYPackages/tree/main/Paquetes/descontinuados/thunderbird-beta</packageSourceUrl>
    <title>[Deprecated] Mozilla Thunderbird Beta</title>
    <authors>Mozilla</authors>
    <owners>DEUS-DEI</owners>
    <projectUrl>https://www.thunderbird.net/en-US/thunderbird/beta/all/</projectUrl>
    <licenseUrl>https://www.mozilla.org/en-US/about/legal/terms/thunderbird/</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><![CDATA[## Deprecated

This package ID has been retired. The same software is now published as **thunderbird-mozilla**, which is installed automatically as a dependency of this package, so existing installations keep receiving updates.

You may safely uninstall this package (thunderbird-beta) after the upgrade.
]]></description>
    <summary>Transitional package towards thunderbird-mozilla</summary>
    <releaseNotes>999.0.1-deprecated: package deprecated in favour of thunderbird-mozilla (installed as a dependency).</releaseNotes>
    <tags>deprecated thunderbird</tags>
    <dependencies>
      <!-- thunderbird-mozilla only publishes prerelease versions. choco only resolves a prerelease dependency for a package that is a prerelease itself, or when the user asks for prereleases: that is why this bridge is a prerelease version -->
      <dependency id="thunderbird-mozilla" version="158.0.0-beta1" />
    </dependencies>
  </metadata>
  <files />
</package>
