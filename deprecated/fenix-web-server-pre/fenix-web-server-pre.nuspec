<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>fenix-web-server-pre</id>
    <version>999.0.1-deprecated</version>
    <packageSourceUrl>https://github.com/DEUS-DEI/ChocoLateYPackages/tree/main/deprecated/fenix-web-server-pre</packageSourceUrl>
    <title>[Deprecated] Fenix Web Server (Pre-release)</title>
    <authors>Ecor Ventures LLC</authors>
    <owners>DEUS-DEI</owners>
    <projectUrl>https://preview.fenixwebserver.com</projectUrl>
    <licenseUrl>https://github.com/coreybutler/fenix/blob/master/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><![CDATA[## Deprecated

This package ID has been retired. Fenix pre-releases are now published as prerelease versions of **fenix-web-server** (`choco install fenix-web-server --pre`), which is installed automatically as a dependency of this package, so existing installations keep receiving updates.

You may safely uninstall this package (fenix-web-server-pre) after the upgrade.
]]></description>
    <summary>Transitional package towards fenix-web-server</summary>
    <releaseNotes>999.0.1-deprecated: package deprecated in favour of fenix-web-server (pre-releases), installed as a dependency.</releaseNotes>
    <tags>deprecated fenix</tags>
    <dependencies>
      <!-- The Fenix 3.x builds are prerelease versions of fenix-web-server. choco only resolves a prerelease dependency for a package that is a prerelease itself, or when the user asks for prereleases: that is why this bridge is a prerelease version -->
      <dependency id="fenix-web-server" version="3.0.0-rc13-20261004" />
    </dependencies>
  </metadata>
  <files />
</package>
