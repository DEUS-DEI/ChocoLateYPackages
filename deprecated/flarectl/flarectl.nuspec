<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>flarectl</id>
    <version>0.47.1</version>
    <packageSourceUrl>https://github.com/DEUS-DEI/ChocoLateYPackages/tree/main/deprecated/flarectl</packageSourceUrl>
    <owners>DEUS-DEI</owners>
    <title>[DEPRECATED] flarectl, Cloudflare CLI</title>
    <authors>Cloudflare</authors>
    <projectUrl>https://www.cloudflare.com/es-es/dns/</projectUrl>
    <iconUrl>https://www.cloudflare.com/static/07c330059a6e7ba8289566756ba405aa/dns-hero-illustration.svg</iconUrl>
    <copyright>2022 Cloudflare, Inc.</copyright>
    <licenseUrl>https://github.com/cloudflare/cloudflare-go/blob/master/LICENSE</licenseUrl>	
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/cloudflare/cloudflare-go/tree/master/cmd/flarectl</projectSourceUrl>
    <docsUrl>https://support.cloudflare.com/hc/en-us/articles/360000841472</docsUrl>
    <bugTrackerUrl>https://github.com/cloudflare/cloudflare-go/issues</bugTrackerUrl>
    <tags>flarectl cloudflare cli tool deprecated discontinued</tags>
    <summary>Deprecated package that now installs cloudflared as a maintained Cloudflare CLI alternative.</summary>
    <dependencies>
      <dependency id="cloudflared" />
    </dependencies>
    <description>
This package is deprecated and no longer receives updates.

Cloudflare has moved away from maintaining flarectl binaries for Windows.
Installing this package will install `cloudflared` as a maintained Cloudflare CLI alternative.</description>
    <releaseNotes>https://github.com/cloudflare/cloudflare-go/releases</releaseNotes>
  </metadata>
</package>
