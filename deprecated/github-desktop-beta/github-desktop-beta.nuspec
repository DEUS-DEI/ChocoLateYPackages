<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>github-desktop-beta</id>
    <version>999.0.0</version>
    <packageSourceUrl>https://github.com/DEUS-DEI/ChocoLateYPackages/tree/main/deprecated/github-desktop-beta</packageSourceUrl>
    <title>[Deprecated] GitHub Desktop Beta</title>
    <authors>GitHub, Inc.</authors>
    <owners>DEUS-DEI</owners>
    <projectUrl>https://desktop.github.com/</projectUrl>
    <licenseUrl>https://github.com/desktop/desktop/blob/development/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description><![CDATA[## Deprecated

This package ID has been retired. The same software is now published as **github-desktop-pre**, which is installed automatically as a dependency of this package, so existing installations keep receiving updates.

You may safely uninstall this package (github-desktop-beta) after the upgrade.
]]></description>
    <summary>Transitional package towards github-desktop-pre</summary>
    <releaseNotes>999.0.0: package deprecated in favour of github-desktop-pre (installed as a dependency).</releaseNotes>
    <tags>deprecated github</tags>
    <dependencies>
      <!-- github-desktop-pre only publishes prerelease versions: a prerelease lower bound lets the dependency resolve -->
      <dependency id="github-desktop-pre" version="3.0.6-beta2" />
    </dependencies>
  </metadata>
  <files />
</package>
